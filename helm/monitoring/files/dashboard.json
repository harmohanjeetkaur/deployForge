{
  "uid": "deployforge-local",
  "title": "DeployForge \u2014 Local Platform Health",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "15s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "Collection scope",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "Live workload, ArgoCD and HTTP probes. API request panels require an instrumented image and applicationMetrics.enabled. Missing HTTP series mean unavailable, not zero. Deployment-operation counters and container CPU/memory require separately approved collection."
      }
    },
    {
      "id": 2,
      "title": "Ready replicas",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "deployforge-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 27,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "kube_deployment_status_replicas_available{namespace=\"deployforge-gitops\",deployment=\"deployforge\"}",
          "legendFormat": "{{instance}} {{pod}} {{sync_status}} {{health_status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "Desired replicas",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "deployforge-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 27,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "kube_deployment_spec_replicas{namespace=\"deployforge-gitops\",deployment=\"deployforge\"}",
          "legendFormat": "{{instance}} {{pod}} {{sync_status}} {{health_status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "Application probes",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "deployforge-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 35,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "probe_success{job=\"application-probes\"}",
          "legendFormat": "{{instance}} {{pod}} {{sync_status}} {{health_status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 5,
      "title": "Scrape targets",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "deployforge-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 35,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up",
          "legendFormat": "{{instance}} {{pod}} {{sync_status}} {{health_status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 6,
      "title": "Pod readiness",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "deployforge-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 43,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "kube_pod_status_ready{namespace=\"deployforge-gitops\",condition=\"true\"}",
          "legendFormat": "{{instance}} {{pod}} {{sync_status}} {{health_status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 7,
      "title": "Pod restarts",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "deployforge-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 43,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "kube_pod_container_status_restarts_total{namespace=\"deployforge-gitops\"}",
          "legendFormat": "{{instance}} {{pod}} {{sync_status}} {{health_status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 8,
      "title": "ArgoCD sync and health",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "deployforge-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 51,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "argocd_app_info{name=\"deployforge\"}",
          "legendFormat": "{{instance}} {{pod}} {{sync_status}} {{health_status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 9,
      "title": "Container CPU \u2014 pending collector",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "deployforge-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 51,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(container_cpu_usage_seconds_total{namespace=\"deployforge-gitops\",container!=\"\"}[5m]))",
          "legendFormat": "{{instance}} {{pod}} {{sync_status}} {{health_status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 10,
      "title": "Container memory \u2014 pending collector",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "deployforge-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 59,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(container_memory_working_set_bytes{namespace=\"deployforge-gitops\",container!=\"\"})",
          "legendFormat": "{{instance}} {{pod}} {{sync_status}} {{health_status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 20,
      "title": "API requests per second",
      "description": "Application HTTP metrics are unavailable until the separately approved image rollout and scrape enablement. Health probes already collect real availability.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "deployforge-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(deployforge_http_requests_total{job=\"deployforge-api\",route!~\"/healthz|/readyz\"}[5m]))",
          "legendFormat": "{{code}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 21,
      "title": "API HTTP 5xx error ratio",
      "description": "Application HTTP metrics are unavailable until the separately approved image rollout and scrape enablement. Health probes already collect real availability.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "deployforge-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 3,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(rate(deployforge_http_requests_total{job=\"deployforge-api\",code=~\"5..\",route!~\"/healthz|/readyz\"}[5m])) or (0 * sum(rate(deployforge_http_requests_total{job=\"deployforge-api\",route!~\"/healthz|/readyz\"}[5m])))) / sum(rate(deployforge_http_requests_total{job=\"deployforge-api\",route!~\"/healthz|/readyz\"}[5m]))",
          "legendFormat": "{{code}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 22,
      "title": "API P95 response latency",
      "description": "Application HTTP metrics are unavailable until the separately approved image rollout and scrape enablement. Health probes already collect real availability.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "deployforge-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(deployforge_http_request_duration_seconds_bucket{job=\"deployforge-api\",route!~\"/healthz|/readyz\"}[5m])))",
          "legendFormat": "{{code}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 23,
      "title": "API in-flight requests",
      "description": "Application HTTP metrics are unavailable until the separately approved image rollout and scrape enablement. Health probes already collect real availability.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "deployforge-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 11,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(deployforge_http_requests_in_flight{job=\"deployforge-api\"})",
          "legendFormat": "{{code}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 24,
      "title": "API response codes",
      "description": "Application HTTP metrics are unavailable until the separately approved image rollout and scrape enablement. Health probes already collect real availability.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "deployforge-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (code) (rate(deployforge_http_requests_total{job=\"deployforge-api\",route!~\"/healthz|/readyz\"}[5m]))",
          "legendFormat": "{{code}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 25,
      "title": "Application availability \u2014 health probes",
      "description": "Application HTTP metrics are unavailable until the separately approved image rollout and scrape enablement. Health probes already collect real availability.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "deployforge-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 19,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "min(probe_success{job=\"application-probes\"})",
          "legendFormat": "{{code}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0
        },
        "overrides": []
      }
    }
  ]
}
